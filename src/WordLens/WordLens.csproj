<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>10.0</LangVersion>
    <AssemblyName>WordLens</AssemblyName>
    <RootNamespace>WordLens</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\wordlens.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>false</PublishSingleFile>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <Version>1.0.1</Version>
    <Product>WordLens</Product>
    <Description>Windows double-click word lookup popup with IPA, translations and dictionary import</Description>
    <Company>WordLens</Company>
    <Copyright>Dictionary data: ECDICT, CC-CEDICT</Copyright>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="6.0.36" />
  </ItemGroup>


  <ItemGroup>
    <None Update="Assets\wordlens.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\wordlens-1024.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
